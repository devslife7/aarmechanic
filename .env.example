# ─── Site ─────────────────────────────────────────────────────────
# Production canonical URL (no trailing slash). Used for canonical,
# OpenGraph, sitemap, robots.txt, and JSON-LD schema.
NEXT_PUBLIC_SITE_URL=https://anywhereautorepair.net

# Google Search Console HTML meta-tag verification code.
# Claim the site at https://search.google.com/search-console then
# paste the meta-tag content value here (NOT the full <meta ...> tag).
NEXT_PUBLIC_GSC_VERIFICATION=

# ─── Google Places (for live reviews on homepage) ─────────────────
GOOGLE_PLACES_API_KEY=

# ─── Resend (contact form transactional email) ────────────────────
RESEND_API_KEY=
FROM_EMAIL=noreply@contact.marcosvelasco.com
CONTACT_EMAIL=devslife7@gmail.com
